# Postgres. Railway injects this automatically when the Postgres service is linked.
DATABASE_URL=

# Private shared secret between radar-worker and the app. Generate a long random value.
INTERNAL_SYNC_TOKEN=replace_with_a_long_random_secret

# Protects external ingestors/backfill endpoints from arbitrary public writes.
WRITE_API_TOKEN=replace_with_another_long_random_secret

# Required for proof-verified FOMO handle -> EVM wallet resolution
FOMOSCAN_API_KEY=fsk_live_replace_me

# Recommended: production-grade Robinhood Chain RPC (Alchemy/QuickNode/etc.).
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# App service should normally leave LIVE_SYNC=false when a separate worker is used.
LIVE_SYNC=false
POLL_SECONDS=120
BACKFILL_BLOCKS=1200
MAX_BLOCK_RANGE=500
PORT=8787

# Worker only: public/private URL of the app service.
APP_BASE_URL=https://replace-me.up.railway.app
