# Postgres. Railway injects this automatically when the Postgres service is linked.
DATABASE_URL=

# Private shared secret between radar-worker and the app. Generate a long random value.
INTERNAL_SYNC_TOKEN=replace_with_a_long_random_secret

# Protects external ingestors/backfill endpoints from arbitrary public writes.
WRITE_API_TOKEN=replace_with_another_long_random_secret

# Primary Social Radar: public FxTwitter + public Telegram, no API keys required.
# Candidate posts are accepted only with exact EVM contracts and every contract is
# verified on Robinhood Chain before becoming SCOUT/WATCH. Telegram forwards are dropped.
FXTWITTER_API_BASE=https://api.fxtwitter.com
TELEGRAM_PUBLIC_BASE=https://t.me/s
SOCIAL_LOOKBACK_MINUTES=10

# Optional Social Radar supplement: proof-verified FOMO identity + thesis feed.
# Not required for the free public feeds. SCOUT never creates Alpha by itself.
FOMOSCAN_API_KEY=
FOMOSCAN_API_BASE=https://api.fomoscan.sh
SOCIAL_IDENTITY_REFRESH_MS=21600000

# Robinhood Chain RPC. Keep the official endpoint as fallback; an Alchemy RPC can be used here later.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Preferred real-time wallet feed: Alchemy Address Activity webhook.
# Both values are required before /api/webhooks/alchemy becomes active.
ALCHEMY_WEBHOOK_ID=
ALCHEMY_WEBHOOK_SIGNING_KEY=

# Bounded real-execution pilot. Keep disabled unless the deployment is deliberately armed.
# ALCHEMY_WALLET_API_KEY may be omitted when RH_RPC_URL is an Alchemy /v2 endpoint.
ALCHEMY_WALLET_API_KEY=
ALCHEMY_GAS_POLICY_ID=
LIVE_SESSION_PRIVATE_KEY=
LIVE_EXECUTION_ALLOWED=false
LIVE_OWNER_ADDRESS=
LIVE_PILOT_BANKROLL_WEI=5000000000000000
LIVE_SESSION_SPEND_WEI=4000000000000000
LIVE_MAX_ENTRY_WEI=1000000000000000
LIVE_VALIDATION_ENTRY_WEI=100000000000000
LIVE_DAILY_LOSS_WEI=1500000000000000
LIVE_GAS_RESERVE_WEI=500000000000000
LIVE_MAX_OPEN_POSITIONS=1
LIVE_SESSION_DAYS=7
LIVE_SLIPPAGE_BPS=300
LIVE_STOP_LOSS_BPS=1200
LIVE_TRAIL_ARM_BPS=3500
LIVE_TRAIL_GIVEBACK_BPS=1800
LIVE_QUOTE_TTL_MS=20000
LIVE_EVIDENCE_TTL_MS=180000
LIVE_DECISION_TTL_MS=180000

# Optional indexed polling/backfill fallback.
BLOCKSCOUT_API_KEY=

# App service should normally leave LIVE_SYNC=false when a separate worker is used.
LIVE_SYNC=false
POLL_SECONDS=120
BACKFILL_BLOCKS=1200
MAX_BLOCK_RANGE=500
PORT=8787

# Worker only: public/private URL of the app service.
APP_BASE_URL=https://replace-me.up.railway.app
